# Port for the backend server to run on
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/fullstackapp

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Qdrant Vector DB Configuration
# For local Qdrant: http://localhost:6333
# For Qdrant Cloud: https://xxxxxx.aws.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cve_knowledge_base_v2

# Embedding Configuration
# Option A: Hugging Face Inference API (Default)
# Leave EMBEDDING_URL empty. Set EMBEDDING_MODEL to your HF repository name.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_API_TOKEN=your_hugging_face_user_access_token_here

# Option B: Custom Embedding Python Service
# If you run the python embedding service, set EMBEDDING_URL to its endpoint (e.g. http://localhost:8000 or your Render service URL)
# EMBEDDING_URL=http://localhost:8000
